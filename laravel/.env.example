APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aktienki
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
AKTIENKI_PYTHON_ENGINE_PATH=/Users/silviotaubert/Downloads/python-engine
AKTIENKI_PYTHON_EXECUTABLE=/Users/silviotaubert/Downloads/python-engine/.venv/bin/python
PYTHON_ENGINE_BACKTESTS=false
PORTFOLIO_AUTOMATION_ENABLED=false
AKTIENKI_PRODUCTION_MODEL_VERSION=horizon-fusion-v1
AKTIENKI_PRODUCTION_MODEL_ROOT=/var/lib/aktienki/models/horizon-fusion-v1
AKTIENKI_PRODUCTION_MODEL_STATUS=canary
AKTIENKI_BETA_ENABLED=true
AKTIENKI_BETA_PHASE_ENDED=false
AKTIENKI_BETA_CONTACT_EMAIL=info@aktienki.com

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.strato.de
MAIL_PORT=465
MAIL_USERNAME="postfach@deine-domain.de"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="postfach@deine-domain.de"
AKTIENKI_BETA_CONTACT_EMAIL="admin@deine-domain.de"
MAIL_FROM_NAME="aKI · aktienKI.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legal provider details (required before public launch)
LEGAL_COMPANY_NAME="ML Software UG (haftungsbeschränkt)"
LEGAL_REPRESENTATIVE="Silvio Täubert"
LEGAL_STREET="Dr.-Rudolf-Friedrichs-Straße 2b"
LEGAL_POSTAL_CODE="01445"
LEGAL_CITY="Radebeul"
LEGAL_COUNTRY="Deutschland"
LEGAL_EMAIL="kontakt@aktienki.com"
LEGAL_PHONE=
LEGAL_REGISTER_COURT=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
LEGAL_FORMATION_STATUS=
LEGAL_PRIVACY_EMAIL="datenschutz@aktienki.com"
LEGAL_DOCUMENT_VERSION="1.0-beta"
LEGAL_EFFECTIVE_DATE="2026-08-16"

TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_INDEXES_ENABLED=false

# Top-10 screening explanations: enable later for bilingual output.
OPENAI_SCREENING_BILINGUAL=false

REVERB_APP_ID=aktienki
REVERB_APP_KEY=aktienki
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Python engine installed locally on the production server. Training may run
# elsewhere, but daily predictions must not depend on the workstation.
AKTIENKI_PYTHON_ENGINE_PATH=/home/aktienki/AktienKI/python-engine
AKTIENKI_PYTHON_EXECUTABLE=/home/aktienki/AktienKI/python-engine/.venv/bin/aktienki-engine
AKTIENKI_SERVER_PREDICTIONS_ENABLED=false
AKTIENKI_SERVER_PREDICTION_LIMIT=5000
AKTIENKI_SERVER_PREDICTION_TIMEOUT=7200
