APP_ENV=local
APP_NAME=AktienKI Python Engine
API_HOST=0.0.0.0
API_PORT=8100
API_TOKEN=change-me

DATABASE_URL=postgresql+psycopg://aktienki_app:change-me@postgres:5432/aktienki
REDIS_URL=redis://redis:6379/0

SHARED_STORAGE_PATH=/shared-storage
MODEL_STORAGE_PATH=/shared-storage/models
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=5
WORKER_NAME=local-worker-1

STOCK_DEFAULT_INTERVAL=1d
STOCK_DEFAULT_HISTORY_YEARS=10
FOREX_DEFAULT_INTERVAL=15m
FOREX_DEFAULT_HISTORY_YEARS=3
